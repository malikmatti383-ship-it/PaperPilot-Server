# PaperPilot server — environment variables
# Copy to .env for local dev (never commit .env with real secrets).

# Port the server listens on (Render sets this automatically — leave unset there)
PORT=3000

# MongoDB connection string. Reuse your existing Atlas cluster: copy MONGODB_URI
# from your other Render service's env vars and change ONLY the database name
# in the path to /paperstock, e.g.:
#   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/paperstock?retryWrites=true&w=majority
MONGODB_URI=

# Google OAuth 2.0 web client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of THIS server, no trailing slash. Set after first Render deploy, e.g.:
#   https://paper-stock-server.onrender.com
# The OAuth redirect URI will be: <SERVER_URL>/auth/google/callback
SERVER_URL=

# Public URL of the PaperPilot PWA, no trailing slash
PWA_URL=https://malikmatti383-ship-it.github.io/Paper-Stock
